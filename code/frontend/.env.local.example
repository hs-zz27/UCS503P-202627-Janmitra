LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=janmitra-agent
NEXT_PUBLIC_LIVEKIT_AGENT_NAME=janmitra-agent

# Required for production/hosted harnesses; optional for loopback-only development.
# Enter this code in the browser. Keep it server-side (never NEXT_PUBLIC_).
JANMITRA_HARNESS_ACCESS_CODE=

# Set the exact public origin when behind an HTTPS reverse proxy.
JANMITRA_HARNESS_ORIGIN=
