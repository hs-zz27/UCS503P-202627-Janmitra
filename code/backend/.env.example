# Janmitra backend — copy to .env and adjust. Never commit a real .env.
JANMITRA_ENV=local
JANMITRA_DATABASE_URL=postgresql+asyncpg://janmitra:janmitra@localhost:5432/janmitra
JANMITRA_LOG_LEVEL=INFO

# Model adapter mode: mock | failure | real
# Load and failure testing MUST run on "mock" (proposal §7, context §12).
JANMITRA_MODEL_ADAPTER=mock
JANMITRA_MOCK_LATENCY_MS=0
JANMITRA_MOCK_FAILURE_RATE=0.0

# Only needed when JANMITRA_MODEL_ADAPTER=real
JANMITRA_GEMINI_API_KEY=
JANMITRA_GEMINI_MODEL=gemini-2.0-flash

# Seeded demo credentials (context §11.6 — three roles, no auth product work).
JANMITRA_ADMIN_API_KEY=dev-admin-key
JANMITRA_OPERATOR_API_KEY=dev-operator-key
JANMITRA_VOICE_API_KEY=dev-voice-key
